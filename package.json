{
  "name": "cma-boromo",
  "version": "0.4.1",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "electron .",
    "electron:prepare": "node scripts/prepare-electron.js",
    "electron:build": "next build && node scripts/prepare-electron.js && electron-builder --win",
    "electron:pack": "next build && node scripts/prepare-electron.js && electron-builder --win --dir",
    "electron:publish": "next build && node scripts/prepare-electron.js && electron-builder --win --publish always"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18",
    "react-to-print": "^2.15.1",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.boromo.hdb",
    "productName": "HDB Boromo",
    "asar": false,
    "files": [
      "electron/**",
      ".next/standalone/**",
      "!.next/standalone/.next/cache/**",
      "!.next/standalone/node_modules/.cache/**",
      "!.next/standalone/node_modules/**/*.md",
      "!.next/standalone/node_modules/**/*.ts",
      "!.next/standalone/node_modules/**/test/**",
      "!.next/standalone/node_modules/**/tests/**",
      "!.next/standalone/node_modules/**/__tests__/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/electron-updater",
        "to": "app/node_modules/electron-updater"
      },
      {
        "from": "node_modules/builder-util-runtime",
        "to": "app/node_modules/builder-util-runtime"
      },
      {
        "from": "node_modules/semver",
        "to": "app/node_modules/semver"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HDB Boromo",
      "installerHeaderIcon": "electron/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "tonde20",
      "repo": "consultation-app",
      "private": true,
      "releaseType": "release"
    }
  }
}
